@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!define AzurePuml https://raw.githubusercontent.com/plantuml-stdlib/Azure-PlantUML/release/2-2/dist
!includeurl AzurePuml/AzureC4Integration.puml
!includeurl AzurePuml/AzureCommon.puml
!includeurl AzurePuml/Databases/AzureDatabaseForPostgreSQL.puml
!includeurl AzurePuml/Containers/AzureKubernetesService.puml
!includeurl AzurePuml/Networking/AzureApplicationGateway.puml
!includeurl AzurePuml/Containers/AzureContainerApp.puml
!includeurl AzurePuml/Identity/AzureActiveDirectory.puml
!includeurl AzurePuml/Storage/AzureBlobStorage.puml

SHOW_PERSON_OUTLINE()
LAYOUT_WITH_LEGEND()
AddElementTag("v1.0",  $borderColor="red" )
AddElementTag("storage", $shape=RoundedBoxShape())

Person(user, "User", "Uploads and retrieves documents")

Enterprise_Boundary(ep, "Azure") {
  System_Ext(extapp, "External Application", "Azure-hosted application with a service principal authorized to call the DNStoFD API")
  System(app, "DNStoFD", "Parses uploaded documents and stores extracted content")
  System(storage, "Azure Storage Account", "Stores parsed document blobs")
  System(dbserver, "Azure Database for PostgreSQL", "Stores users, document records, ownership, and document metadata")
  System_Ext(entra, "Azure Entra ID", "Issues and validates identity tokens")
}

Rel(user, app, "Uploads and retrieves documents via HTTPS")
Rel(extapp, app, "Calls document APIs via HTTPS")
Rel(app, entra, "Validates bearer tokens using OIDC/JWKS")
Rel(app, storage, "Stores parsed document content in")
Rel(app, dbserver, "Stores user and document records in")

@enduml
